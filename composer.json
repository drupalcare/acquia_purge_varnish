{
    "name": "drupal/acquia_purge_varnish",
    "description": "Varnish cache purging integration for Acquia Cloud environments with environment-specific controls.",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/acquia_purge_varnish",
    "authors": [
        {
            "name": "Alaa Haddad",
            "email": "info@alaahaddad.com",
            "homepage": "https://alaahaddad.com",
            "role": "Maintainer"
        },
        {
            "name": "Flash Web Center LLC",
            "homepage": "https://flashwebcenter.com",
            "role": "Organization"
        }
    ],
    "support": {
        "issues": "https://www.drupal.org/project/issues/acquia_purge_varnish",
        "source": "https://git.drupalcode.org/project/acquia_purge_varnish",
    },
    "require": {
        "php": ">=8.1",
        "drupal/core": "^10 || ^11"
    },
    "require-dev": {
        "drupal/core-dev": "^10 || ^11"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
