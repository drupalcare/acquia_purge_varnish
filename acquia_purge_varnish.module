declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\acquia_purge_varnish\Hook\AcquiaPurgeVarnishHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function acquia_purge_varnish_help(string $route_name, RouteMatchInterface $route_match): ?string {
  return \Drupal::service(AcquiaPurgeVarnishHooks::class)->help($route_name, $route_match);
}
