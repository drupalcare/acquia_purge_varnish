/**
 * Implements hook_uninstall().
 */
function acquia_purge_varnish_uninstall($is_syncing) {
  if ($is_syncing) {
    return;
  }
  \Drupal::configFactory()
    ->getEditable('acquia_purge_varnish_form.settings')
    ->delete();
}
