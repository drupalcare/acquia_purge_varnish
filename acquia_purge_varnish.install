<?php

declare(strict_types=1);

/**
 * @file
 * Install, update and uninstall functions for the Acquia Purge Varnish module.
 */


use Drupal\Core\Url;

/**
 * Implements hook_install().
 */
function acquia_purge_varnish_install(): void {
  // Set default configuration values.
  $config = \Drupal::configFactory()->getEditable('acquia_purge_varnish.settings');

  if ($config->get('domain') === NULL) {
    $config->set('domain', 'current');
  }

  if ($config->get('log_requests') === NULL) {
    $config->set('log_requests', FALSE);
  }

  $config->save();

  // Inform user about next steps.
  \Drupal::messenger()->addStatus(t('Acquia Purge Varnish has been installed. <a href="@url">Configure API credentials</a> to enable Varnish cache purging.', [
    '@url' => Url::fromRoute('acquia_purge_varnish.form')->toString(),
  ]));

  // Log installation.
  \Drupal::logger('acquia_purge_varnish')->notice('Acquia Purge Varnish module installed successfully.');
}

/**
 * Implements hook_uninstall().
 */
function acquia_purge_varnish_uninstall(): void {
  // Clean up configuration.
  \Drupal::configFactory()->getEditable('acquia_purge_varnish.settings')->delete();

  // Log uninstallation.
  \Drupal::logger('acquia_purge_varnish')->notice('Acquia Purge Varnish module uninstalled. Configuration removed.');
}

/**
 * Implements hook_requirements().
 */
function acquia_purge_varnish_requirements(string $phase): array {
  $requirements = [];

  // Check for OAuth library during install and runtime.
  if ($phase === 'install' || $phase === 'runtime') {
    if (!class_exists('\League\OAuth2\Client\Provider\GenericProvider')) {
      $requirements['acquia_purge_varnish_oauth'] = [
        'title' => t('Acquia Purge Varnish - OAuth2 Client Library'),
        'description' => t('The league/oauth2-client library is required. Install it with: <code>composer require league/oauth2-client:^2.7</code>'),
        'severity' => REQUIREMENT_ERROR,
        'value' => t('Not installed'),
      ];
    }
    else {
      $requirements['acquia_purge_varnish_oauth'] = [
        'title' => t('Acquia Purge Varnish - OAuth2 Client Library'),
        'value' => t('Installed'),
        'severity' => REQUIREMENT_OK,
      ];
    }
  }

  // Runtime-specific checks.
  if ($phase === 'runtime') {
    $config = \Drupal::config('acquia_purge_varnish.settings');
    $settings = \Drupal::service('settings');

    // Check if credentials are configured (in config or settings.php).
    $settingsOverride = $settings->get('acquia_purge_varnish_credentials');
    $apiKey = $settingsOverride['api_key'] ?? $config->get('api_key');
    $apiSecret = $settingsOverride['api_secret'] ?? $config->get('api_secret');

    if (empty($apiKey) || empty($apiSecret)) {
      $requirements['acquia_purge_varnish_credentials'] = [
        'title' => t('Acquia Purge Varnish - API Credentials'),
        'value' => t('Not configured'),
        'description' => t('API credentials are required for Varnish purging. <a href="@url">Configure credentials now</a> or add them to settings.php.', [
          '@url' => Url::fromRoute('acquia_purge_varnish.form')->toString(),
        ]),
        'severity' => REQUIREMENT_WARNING,
      ];
    }
    else {
      $source = !empty($settingsOverride) ? 'settings.php' : 'configuration form';
      $requirements['acquia_purge_varnish_credentials'] = [
        'title' => t('Acquia Purge Varnish - API Credentials'),
        'value' => t('Configured via @source', ['@source' => $source]),
        'severity' => REQUIREMENT_OK,
      ];
    }

    // Check if running on Acquia Cloud Platform.
    try {
      /** @var \Drupal\acquia_purge_varnish\AcquiaPurgeVarnishApiClient $apiClient */
      $apiClient = \Drupal::service('acquia_purge_varnish.api_client');

      if ($apiClient->isAcquiaEnvironment()) {
        $environment = $apiClient->getAcquiaEnvironment();
        $siteGroup = $apiClient->getAcquiaSiteGroup();

        $requirements['acquia_purge_varnish_environment'] = [
          'title' => t('Acquia Purge Varnish - Environment'),
          'value' => t('@env environment', ['@env' => ucfirst($environment ?? 'Unknown')]),
          'description' => t('Running on Acquia Cloud Platform (Site: @site)', [
            '@site' => $siteGroup ?? 'Unknown',
          ]),
          'severity' => REQUIREMENT_OK,
        ];
      }
      else {
        $requirements['acquia_purge_varnish_environment'] = [
          'title' => t('Acquia Purge Varnish - Environment'),
          'value' => t('Not on Acquia Cloud Platform'),
          'description' => t('This site is not running on Acquia Cloud Platform. Varnish cache purging will not function. This module is designed specifically for Acquia Cloud environments.'),
          'severity' => REQUIREMENT_INFO,
        ];
      }
    }
    catch (\Exception $e) {
      $requirements['acquia_purge_varnish_environment'] = [
        'title' => t('Acquia Purge Varnish - Environment'),
        'value' => t('Unable to determine'),
        'description' => t('Error checking environment: @error', ['@error' => $e->getMessage()]),
        'severity' => REQUIREMENT_WARNING,
      ];
    }
  }

  return $requirements;
}

/**
 * Update permission machine name to follow Drupal standards.
 *
 * Changes 'Acquia Purge Varnish' to 'administer acquia purge varnish'.
 */
function acquia_purge_varnish_update_9001(): string {
  // Get the role storage.
  $roleStorage = \Drupal::entityTypeManager()->getStorage('user_role');

  // Old permission (if it exists).
  $oldPermission = 'Acquia Purge Varnish';
  // New permission.
  $newPermission = 'administer acquia purge varnish';

  // Load all roles.
  $roles = $roleStorage->loadMultiple();

  $updatedRoles = [];
  foreach ($roles as $role) {
    // Check if role has the old permission.
    if ($role->hasPermission($oldPermission)) {
      // Remove old permission.
      $role->revokePermission($oldPermission);
      // Grant new permission.
      $role->grantPermission($newPermission);
      $role->save();
      $updatedRoles[] = $role->label();
    }
  }

  if (!empty($updatedRoles)) {
    return sprintf(
      'Updated permission from "%s" to "%s" for roles: %s',
      $oldPermission,
      $newPermission,
      implode(', ', $updatedRoles)
    );
  }

  return 'No roles needed permission updates.';
}
